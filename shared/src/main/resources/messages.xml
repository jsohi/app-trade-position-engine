<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="com.bofa.equity.sbe"
                   id="100"
                   version="1"
                   semanticVersion="0.1"
                   description="Bofa trade messages">
    <types>
        <!-- Header  message can be used to define schema/version. Templates can be used to identify which message type it is.
        This is overkill for current exercise, but useful in prod env where we have diff type/versions of message -->
        <composite name="messageHeader" description="Message identifiers and length of message root">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>

        <!-- SBE chars are single byte (8 bits) * 32 = 32 bytes -->
        <type name="ReferenceIdType" primitiveType="char" length="32" characterEncoding="ASCII"/>

        <!-- single byte (8 bits) using short -->
        <type name="AccountIdType" primitiveType="uint8" minValue="1" maxValue="10"/>

        <!-- two bytes (16 bits) — uint16 required to hold values up to 2000 (uint8 max is 255) -->
        <type name="SecurityIdType" primitiveType="uint16" minValue="1" maxValue="2000"/>

        <!-- single byte (8 bits) -->
        <enum name="SideType" encodingType="uint8">
            <validValue name="B" description="Buy">0</validValue>
            <validValue name="S" description="Sell">1</validValue>
        </enum>

        <!-- 64 bits (8byte) -->
        <type name="QuantityType" primitiveType="uint64"/>

        <!-- Out of scope for this exercise, but can be represented in decimals like below
        <composite name="PriceOrAmountType">
            <type name="mantissa" primitiveType="int64"/>
            <type name="exponent" primitiveType="int8"/>
        </composite>-->

        <!-- 64 bits (8byte)  -->
        <type name="PriceType" primitiveType="double"/>

        <!-- 64 bits (8byte) -->
        <type name="TimestampType" primitiveType="uint64"/>

        <!-- 4096 bytes / 2 bytes per char on UTF-8 = max 2048 char length -->
        <composite name="DescriptionStringEncoding" description="Variable length UTF-8 string">
            <type name="length" primitiveType="uint16" maxValue="2048"/>
            <type name="varData" primitiveType="uint16" length="0" characterEncoding="UTF-8"/>
        </composite>

        <!-- ===== RFQ types ===== -->

        <!-- 32-byte ASCII identifiers for RFQ lifecycle -->
        <type name="QuoteReqIdType" primitiveType="char" length="32" characterEncoding="ASCII"/>
        <type name="QuoteIdType" primitiveType="char" length="32" characterEncoding="ASCII"/>
        <type name="PartyIdType" primitiveType="char" length="32" characterEncoding="ASCII"/>
        <type name="SymbolType" primitiveType="char" length="8" characterEncoding="ASCII"/>

        <enum name="RfqSideType" encodingType="uint8">
            <validValue name="BUY" description="Buy">0</validValue>
            <validValue name="SELL" description="Sell">1</validValue>
            <validValue name="BOTH" description="Both sides">2</validValue>
        </enum>

        <enum name="RfqStateType" encodingType="uint8">
            <validValue name="REQUESTED" description="Quote requested">0</validValue>
            <validValue name="QUOTED" description="Quote proposed">1</validValue>
            <validValue name="ACCEPTED" description="Quote accepted">2</validValue>
            <validValue name="REJECTED" description="Quote rejected">3</validValue>
            <validValue name="CANCELLED" description="Quote cancelled">4</validValue>
            <validValue name="EXPIRED" description="Quote expired">5</validValue>
        </enum>

        <type name="SequenceNumberType" primitiveType="uint64"/>

        <!-- Variable-length UTF-8 string for RFQ reason text -->
        <composite name="ReasonStringEncoding" description="Variable length UTF-8 string for rejection reason">
            <type name="length" primitiveType="uint16" maxValue="1024"/>
            <type name="varData" primitiveType="uint16" length="0" characterEncoding="UTF-8"/>
        </composite>

    </types>

    <sbe:message name="Trade" id="1" description="Trade message">

        <field name="referenceId" id="1" type="ReferenceIdType" description="Actual trade reference id"/>

        <!-- Keeping ids in primitive data types, mapping from account strings ids <> primitive types will be handled by some store
            and cached upfront in all trading apps for mapping (Assumption) -->
        <field name="accountId" id="2" type="AccountIdType" description="Account primitive id"/>

        <field name="securityId" id="3" type="SecurityIdType" description="Security primitive id"/>

        <field name="side" id="4" type="SideType" description="Account integer id"/>

        <field name="quantity" id="5" type="uint64" description="Trade quantity"/>

        <field name="price" id="6" type="PriceType" description="Trade price"/>

        <!-- can use nanos for more precision -->
        <field name="timestampMillis" id="7" type="TimestampType" description="Timestamp in millis"/>

        <!--Can be moved out of this message completely and stored somewhere else by publisher via some other aeron publication using microservice,
         as description doesn't play any part in position aggregations-->
        <data name="description" id="8" type="DescriptionStringEncoding" description="Audit descriptive text"/>

    </sbe:message>

    <sbe:message name="AuditTrade" id="2" description="Audit trade message — regulatory/text data on a separate stream">

        <field name="referenceId" id="1" type="ReferenceIdType"          description="Actual trade reference id"/>

        <field name="accountId"   id="2" type="AccountIdType"            description="Account primitive id"/>

        <field name="securityId"  id="3" type="SecurityIdType"           description="Security primitive id"/>

        <data  name="description" id="4" type="DescriptionStringEncoding" description="Audit descriptive text"/>

    </sbe:message>

    <!-- ===== RFQ Command Messages (inbound, stream 20) ===== -->

    <sbe:message name="RequestQuoteCmd" id="10" description="Request for Quote command">
        <field name="quoteReqId"     id="1" type="QuoteReqIdType"/>
        <field name="symbol"         id="2" type="SymbolType"/>
        <field name="side"           id="3" type="RfqSideType"/>
        <field name="quantity"       id="4" type="uint64"/>
        <field name="partyId"        id="5" type="PartyIdType"/>
        <field name="timestampNanos" id="6" type="uint64"/>
    </sbe:message>

    <sbe:message name="ProposeQuoteCmd" id="11" description="Propose Quote command">
        <field name="quoteReqId"     id="1"  type="QuoteReqIdType"/>
        <field name="quoteId"        id="2"  type="QuoteIdType"/>
        <field name="symbol"         id="3"  type="SymbolType"/>
        <field name="bidPx"          id="4"  type="PriceType"/>
        <field name="offerPx"        id="5"  type="PriceType"/>
        <field name="bidSize"        id="6"  type="uint64"/>
        <field name="offerSize"      id="7"  type="uint64"/>
        <field name="validUntilTime" id="8"  type="uint64"/>
        <field name="partyId"        id="9"  type="PartyIdType"/>
        <field name="timestampNanos" id="10" type="uint64"/>
    </sbe:message>

    <sbe:message name="AcceptQuoteCmd" id="12" description="Accept Quote command">
        <field name="quoteReqId"     id="1" type="QuoteReqIdType"/>
        <field name="quoteId"        id="2" type="QuoteIdType"/>
        <field name="partyId"        id="3" type="PartyIdType"/>
        <field name="timestampNanos" id="4" type="uint64"/>
    </sbe:message>

    <sbe:message name="RejectQuoteCmd" id="13" description="Reject Quote command">
        <field name="quoteReqId"     id="1" type="QuoteReqIdType"/>
        <field name="quoteId"        id="2" type="QuoteIdType"/>
        <field name="partyId"        id="3" type="PartyIdType"/>
        <field name="timestampNanos" id="4" type="uint64"/>
        <data  name="reason"         id="5" type="ReasonStringEncoding"/>
    </sbe:message>

    <sbe:message name="CancelQuoteCmd" id="14" description="Cancel Quote command">
        <field name="quoteReqId"     id="1" type="QuoteReqIdType"/>
        <field name="partyId"        id="2" type="PartyIdType"/>
        <field name="timestampNanos" id="3" type="uint64"/>
    </sbe:message>

    <!-- ===== RFQ Event Messages (outbound, stream 21) ===== -->

    <sbe:message name="QuoteRequestedEvt" id="20" description="Quote Requested event">
        <field name="sequenceNumber" id="1" type="SequenceNumberType"/>
        <field name="quoteReqId"     id="2" type="QuoteReqIdType"/>
        <field name="symbol"         id="3" type="SymbolType"/>
        <field name="side"           id="4" type="RfqSideType"/>
        <field name="quantity"       id="5" type="uint64"/>
        <field name="partyId"        id="6" type="PartyIdType"/>
        <field name="state"          id="7" type="RfqStateType"/>
        <field name="timestampNanos" id="8" type="uint64"/>
    </sbe:message>

    <sbe:message name="QuoteProposedEvt" id="21" description="Quote Proposed event">
        <field name="sequenceNumber" id="1"  type="SequenceNumberType"/>
        <field name="quoteReqId"     id="2"  type="QuoteReqIdType"/>
        <field name="quoteId"        id="3"  type="QuoteIdType"/>
        <field name="symbol"         id="4"  type="SymbolType"/>
        <field name="bidPx"          id="5"  type="PriceType"/>
        <field name="offerPx"        id="6"  type="PriceType"/>
        <field name="bidSize"        id="7"  type="uint64"/>
        <field name="offerSize"      id="8"  type="uint64"/>
        <field name="validUntilTime" id="9"  type="uint64"/>
        <field name="partyId"        id="10" type="PartyIdType"/>
        <field name="state"          id="11" type="RfqStateType"/>
        <field name="timestampNanos" id="12" type="uint64"/>
    </sbe:message>

    <sbe:message name="QuoteAcceptedEvt" id="22" description="Quote Accepted event">
        <field name="sequenceNumber" id="1" type="SequenceNumberType"/>
        <field name="quoteReqId"     id="2" type="QuoteReqIdType"/>
        <field name="quoteId"        id="3" type="QuoteIdType"/>
        <field name="partyId"        id="4" type="PartyIdType"/>
        <field name="state"          id="5" type="RfqStateType"/>
        <field name="timestampNanos" id="6" type="uint64"/>
    </sbe:message>

    <sbe:message name="QuoteRejectedEvt" id="23" description="Quote Rejected event">
        <field name="sequenceNumber" id="1" type="SequenceNumberType"/>
        <field name="quoteReqId"     id="2" type="QuoteReqIdType"/>
        <field name="quoteId"        id="3" type="QuoteIdType"/>
        <field name="partyId"        id="4" type="PartyIdType"/>
        <field name="state"          id="5" type="RfqStateType"/>
        <field name="timestampNanos" id="6" type="uint64"/>
        <data  name="reason"         id="7" type="ReasonStringEncoding"/>
    </sbe:message>

    <sbe:message name="QuoteCancelledEvt" id="24" description="Quote Cancelled event">
        <field name="sequenceNumber" id="1" type="SequenceNumberType"/>
        <field name="quoteReqId"     id="2" type="QuoteReqIdType"/>
        <field name="partyId"        id="3" type="PartyIdType"/>
        <field name="state"          id="4" type="RfqStateType"/>
        <field name="timestampNanos" id="5" type="uint64"/>
    </sbe:message>

</sbe:messageSchema>
